  "follow": {
   "offset_avatar_local_m": {
    "right": 0.6,
    "back": 0.9
   },
   "note": "spec section 3: spring offset 0.9 m behind and 0.6 m to the right of the avatar (avatar +Z forward, so right = -X in avatar space); follow_run above SPRINT_SPEED; spawn_poof + snap if the gap > 8 m"
  },
  "lod": {
   "lod0": "pet_<name>.glb, <=6000 tris, base+ORM+normal 1024 (costume <=512)",
