   "switch_m": 12
  },
  "compression": "EXT_meshopt_compression (QUANTIZE filter), required; no KHR_texture_basisu / KTX2",
  "clips": {
   "idle": {
    "dur": 4,
    "loop": true
   },
   "follow_walk": {
    "dur": 1.0,
    "loop": true
   },
   "follow_run": {
    "dur": 0.6,
    "loop": true
   },
   "sit_enter": {
    "dur": 0.4,
    "loop": false,
    "next": "sit"
   },
   "sit": {
    "dur": 4,
    "loop": true
   },
   "emote_happy": {
    "dur": 1.5,
    "loop": "once (loops seamlessly)"
   },
   "emote_dance": {
    "dur": 2,
    "loop": true
   },
   "spawn_poof": {
    "dur": 0.5,
    "loop": false
   }
  },
  "parts_clip": "pet_<name>_parts: 2 s loop, play it always (additively, on top of whichever body clip is playing). It only touches part nodes, never joints.",
  "idle_rules": "0.5 s stopped -> idle; 10 s idle -> sit_enter then sit"
 },
