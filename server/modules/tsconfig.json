{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "outFile": "build/index.js",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2015"],
    "types": [],
    "skipLibCheck": true,
    "sourceMap": false,
    "removeComments": true
  },
  "files": [
    "src/nakama.d.ts",
    "src/schema.ts",
    "src/tickets.ts",
    "src/effects.ts",
    "src/fault.ts",
    "src/rpcs.ts",
    "src/main.ts"
  ]
}
