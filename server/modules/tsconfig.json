{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "outFile": "build/index.js",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2015"
    ],
    "types": [],
    "skipLibCheck": true,
    "sourceMap": false,
    "removeComments": true
  },
  "files": [
    "src/nakama.d.ts",
    "src/sproto_nakama.d.ts",
    "src/sproto_sim.d.ts",
    "src/games/coop_sim.d.ts",
    "src/games/shooter_sim.d.ts",
    "src/shop_seed.ts",
    "src/schema.ts",
    "src/hub_realms.ts",
    "src/hub_games.ts",
    "src/server_economy.ts",
    "src/flags.ts",
    "src/shards.ts",
    "src/leaderboard.ts",
    "src/effects.ts",
    "src/fault.ts",
    "src/hub_gate.ts",
    "src/rpcs.ts",
    "src/chat_words.ts",
    "src/chat_guard.ts",
    "src/rt_hooks.ts",
    "src/hub_match.ts",
    "src/hub_rpcs.ts",
    "src/sproto_duel.ts",
    "src/item_grant.ts",
    "src/pets.ts",
    "src/main.ts"
  ],
  // Game files (Contract C3): emitted after `files`, alphabetically, so they can
  // call HubGames / HubSchema / HubEconomy at top level without being listed.
  "include": ["src/games/*.ts"]
}
