# Local dev keys for server/docker-compose.yml. Copy nothing from here: run
#   sh scripts/dev-env.sh
# from server/ to write server/.env with fresh random values (mode 600).
# server/.env is gitignored. Never commit it, never put these in VITE_* vars,
# and never paste them in chat, PRs or issues.
#
# NAKAMA_SERVER_KEY is the socket server key. Nakama clients send it, so it is
# not a secret; locally it stays Nakama's stock key because the hub dev build
# and vendored SDKs send that. Every other value is server-only.
# NAKAMA_HTTP_KEY is server-to-server only. No client build may contain it.
POSTGRES_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_REFRESH_ENCRYPTION_KEY=
NAKAMA_CONSOLE_USERNAME=
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
TICKET_HMAC_KEY=
RECOVERY_PEPPER=
AUDIT_KEY=
