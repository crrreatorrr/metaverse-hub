# Host Caddy in front of Nakama on 127.0.0.1:7350 and the static trees under /srv.
# {$DOMAIN} is required at process start (systemd EnvironmentFile).
# GAME_COOP_* is 0 or 1 when Caddy loads. 0 leaves COOP/COEP off for that game.
# Reload Caddy after changing a toggle (deploy/scripts/install-caddy.sh does).
# The origin certificate is a Cloudflare Origin CA cert. Visitors never see it.
{
	# Stock Caddy has no Cloudflare IP module. cloudflare-ufw.sh writes this
	# file from the published ranges and reloads Caddy. ufw is what blocks
	# non-Cloudflare clients; this list is only so logs use CF-Connecting-IP.
	import /etc/caddy/cloudflare-proxies.caddy
}

# Same paths on the apex and on play.<domain>. Pages call /v2 and /ws on the
# host that served them. reverse_proxy upgrades /ws when the client sends
# Connection: Upgrade. Production builds leave serverUrl unset.
(nakama_proxy) {
	handle /v2* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:7350
	}
	handle /ws* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:7350
	}
}

# Empty on purpose: COOP/COEP stay unset unless that game's toggle is 1.
(coop_0) {
	header {
		>X-Content-Type-Options nosniff
	}
}

(coop_1) {
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}
}

# args: url path, 0|1 coop toggle, matcher suffix
(game) {
	handle_path /{args[0]}/* {
		root * /srv/play/{args[0]}/current
		@html path_regexp html_{args[2]} "(^/$|\.html$|/asset-manifest\.json$)"
		# Matchers see the path before handle_path strips the game prefix.
		# Godot exports (index.<hash>.wasm|pck|js) and Vite's code chunks
		# (assets/<name>-<8 char hash>.js|css|wasm) never change under one name.
		# Only code: Vite emits it, while a game's public/ can put a hand-named
		# media file such as boss-intro_01.mp3 under assets/ too, and an 8-char
		# tail cannot tell the two apart. An 8-letter lowercase word is never
		# taken for a hash.
		@hashed {
			path_regexp hashed_{args[2]} "^(/{args[0]})?/(index\.[A-Za-z0-9_-]+\.(wasm|pck|js)|assets/(.+/)?[^/]+-[A-Za-z0-9_-]{8}\.(js|mjs|css|wasm))$"
			not path_regexp hashed_word_{args[2]} "-[a-z-]{8}\.[a-z0-9]+$"
		}
		# Hash-looking media: an hour, then the browser revalidates in the background.
		@hashed_media {
			path_regexp hashed_media_{args[2]} "^(/{args[0]})?/assets/(.+/)?[^/]+-[A-Za-z0-9_-]{8}\.(png|webp|jpg|jpeg|avif|glb|ktx2|mp3|ogg|m4a|woff2|svg)$"
			not path_regexp hashed_media_word_{args[2]} "-[a-z-]{8}\.[a-z0-9]+$"
		}
		# Coop-Battle busts caches with ?v=<24 hex> on files it changes.
		@busted {
			expression `{query.v}.matches("^[0-9a-f]{24}$")`
			not path_regexp busted_html_{args[2]} "(^/$|\.html$|/asset-manifest\.json$)"
		}
		@wasm path_regexp wasm_{args[2]} "\.wasm$"
		header Cache-Control "public, max-age=300"
		header @hashed {
			defer
			Cache-Control "public, max-age=31536000, immutable"
		}
		header @hashed_media {
			defer
			Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		}
		header @busted {
			defer
			Cache-Control "public, max-age=31536000, immutable"
		}
		header @html {
			defer
			Cache-Control "no-cache"
		}
		header @wasm Content-Type "application/wasm"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Strict-Transport-Security "max-age=15552000; includeSubDomains"
			-Server
		}
		import coop_{args[1]}
		# Caddy sets Range: bytes=0- so ServeContent emits Content-Length on a
		# precompressed body. That status is 206. Browsers treat a 206 without
		# a client Range as a network error, which breaks wasm. Force 200.
		file_server {
			precompressed br gzip
			status 200
		}
		header {
			defer
			-Content-Range
		}
	}
}

{$DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	log {
		output stdout
		format json
	}
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		-Server
	}

	import nakama_proxy

	redir / /hub/ 308
	redir /hub /hub/ 308
	redir /admin /admin/ 308
	@realm_bare path_regexp hub_realm_bare "^/realm/[^/]+$"
	redir @realm_bare {path}/?{query} 308

	handle /play/* {
		respond "Games are on the play host." 404
	}

	# deploy-hub.sh writes .br and .gz beside each compressible file. Serve
	# those (same 206 workaround as the play host); `encode gzip` above still
	# covers anything without a sibling, and skips a body already encoded.
	handle /assets/* {
		root * /srv/hub/current
		@assetwasm path_regexp hub_asset_wasm "\.wasm$"
		header Cache-Control "public, max-age=31536000, immutable"
		header @assetwasm Content-Type "application/wasm"
		file_server {
			precompressed br gzip
			status 200
		}
		header {
			defer
			-Content-Range
		}
	}

	# /world/ is copied from public/ with stable names, so it cannot be
	# immutable. An hour covers a portal round trip; after that the browser
	# keeps using its copy while it revalidates in the background.
	handle /world/* {
		root * /srv/hub/current
		@worldwasm path_regexp hub_world_wasm "\.wasm$"
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		header @worldwasm Content-Type "application/wasm"
		file_server {
			precompressed br gzip
			status 200
		}
		header {
			defer
			-Content-Range
		}
	}

	handle {
		root * /srv/hub/current
		@html path_regexp hub_html "(^/hub/?$|^/admin/?$|^/realm/[^/]+/?$|\.html$|/asset-manifest\.json$)"
		@wasm path_regexp hub_wasm "\.wasm$"
		header Cache-Control "public, max-age=300"
		header @html {
			defer
			Cache-Control "no-cache"
		}
		header @wasm Content-Type "application/wasm"
		file_server {
			precompressed br gzip
			status 200
		}
		header {
			defer
			-Content-Range
		}
	}
}

www.{$DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	redir https://{$DOMAIN}{uri} 308
}

play.{$DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		-Server
	}

	import nakama_proxy

	redir /hpos10i /hpos10i/ 308
	redir /nobu /nobu/ 308
	redir /peoples-bitcoin /peoples-bitcoin/ 308
	redir /sproto-duel /sproto-duel/ 308
	redir /sproto-fighter /sproto-fighter/ 308
	redir /sproto-arcade /sproto-arcade/ 308
	redir /sproto-shooter /sproto-shooter/ 308
	redir /sproto-coop-battle /sproto-coop-battle/ 308
	redir /sproto-open-world /sproto-open-world/ 308

	import game hpos10i {$GAME_COOP_HPOS10I:0} hpos10i
	import game nobu {$GAME_COOP_NOBU:0} nobu
	import game peoples-bitcoin {$GAME_COOP_PEOPLES_BITCOIN:0} peoples_bitcoin
	import game sproto-duel {$GAME_COOP_SPROTO_DUEL:0} sproto_duel
	import game sproto-fighter {$GAME_COOP_SPROTO_FIGHTER:0} sproto_fighter
	import game sproto-arcade {$GAME_COOP_SPROTO_ARCADE:0} sproto_arcade
	import game sproto-shooter {$GAME_COOP_SPROTO_SHOOTER:0} sproto_shooter
	import game sproto-coop-battle {$GAME_COOP_SPROTO_COOP_BATTLE:0} sproto_coop_battle
	import game sproto-open-world {$GAME_COOP_SPROTO_OPEN_WORLD:0} sproto_open_world

	# Character rigs and stage packs shared by sproto-duel and sproto-shooter, deployed once under
	# /srv/play/shared-assets/sproto/current. Names are hand-picked, so nothing is immutable: an hour,
	# then background revalidation (like the hub's /world/).
	handle_path /shared-assets/sproto/* {
		root * /srv/play/shared-assets/sproto/current
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		header {
			X-Content-Type-Options nosniff
			Access-Control-Allow-Origin *
			Cross-Origin-Resource-Policy cross-origin
			-Server
		}
		file_server {
			precompressed br gzip
			status 200
		}
		header {
			defer
			-Content-Range
		}
	}

	handle {
		respond "play host" 404
	}
}
