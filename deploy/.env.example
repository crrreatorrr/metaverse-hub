# Copy to deploy/.env and chmod 600. Names only in git. No quotes, no export.
# Generate each secret with: openssl rand -hex 32
# Hex is required: letters, digits, underscore, and hyphen only.

# Apex hostname. No scheme, no path, no trailing dot. Example: play.example.com is derived.
DOMAIN=

# Postgres superuser password. Applied on the first init of the volume.
POSTGRES_PASSWORD=

# Nakama socket server key. The only Nakama value that belongs in a client.
# Inject it at build time from CI secrets or an uncommitted .env.production.
# Leave serverUrl unset in production. That setting is for dev, mock, and QA only.
NAKAMA_SERVER_KEY=

# Nakama runtime HTTP key. Server only. Never put this in a client bundle.
NAKAMA_HTTP_KEY=

# Sign session and refresh tokens. Server only. Changing either logs every player out.
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_REFRESH_ENCRYPTION_KEY=

# Nakama console on 127.0.0.1:7351, through an SSH tunnel. Server only.
# Never put the password or the signing key in a client bundle.
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=

# Runtime env. Server only. Ticket HMAC signs portal tickets. Recovery pepper hashes recovery codes.
TICKET_HMAC_KEY=
RECOVERY_PEPPER=

# SharedArrayBuffer. 0 leaves COOP/COEP off. 1 sends same-origin + require-corp for that game only.
GAME_COOP_HPOS10I=0
GAME_COOP_NOBU=0
GAME_COOP_PEOPLES_BITCOIN=0
GAME_COOP_SPROTO_DUEL=0

# Optional. One CIDR allowed to SSH, for example 203.0.113.10/32. Empty allows SSH from anywhere.
SSH_ALLOW_CIDR=

# Optional. rsync target for dumps, for example backup@backup.example:/srv/nakama-dumps/
# Empty keeps dumps only on this VPS.
BACKUP_RSYNC_TARGET=

# Days of local dumps to keep.
BACKUP_RETAIN_DAYS=14
