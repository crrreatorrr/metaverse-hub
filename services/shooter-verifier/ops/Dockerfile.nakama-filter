FROM node:22-alpine AS modules
WORKDIR /src
COPY server/modules/package.json server/modules/package-lock.json ./
RUN npm ci
COPY server/modules/tsconfig.json server/modules/embed-shop.mjs server/modules/append-vendor.mjs ./
COPY server/modules/vendor ./vendor
COPY server/data/pb_shop_prices.csv server/data/follower-pets.json ./data/
COPY server/modules/src ./src
RUN npm run build

FROM heroiclabs/nakama:3.41.0 AS nakama
FROM node:22-bookworm-slim AS nakama-filter-base
WORKDIR /nakama
COPY --from=nakama /nakama/nakama /nakama/nakama
COPY --from=modules /src/build/index.js /nakama/data/modules/index.js
COPY services/shooter-verifier/ops/redact-log.mjs services/shooter-verifier/ops/nakama-filter.mjs services/shooter-verifier/ops/safe-metrics.mjs /app/
ENTRYPOINT ["node","/app/nakama-filter.mjs"]
CMD []

# This target exists only for the disposable driver-fault workflow. It is never
# selected by the example profile default, and contains a deliberately failing
# SQL RPC which must never be included in an operational image.
FROM nakama-filter-base AS nakama-filter-fixture
COPY services/shooter-verifier/test/nakama-filter-fixture.js /tmp/nakama-filter-fixture.js
# Nakama resolves callbacks by the original InitModule AST and rejects inline
# callbacks. Add one named registration at a unique reviewed test-only anchor.
RUN node -e 'const fs=require("node:fs"); const p="/nakama/data/modules/index.js"; const s=fs.readFileSync(p,"utf8"); const a="initializer.registerRpc(\"healthcheck\", rpcHealthcheck);"; if(s.split(a).length!==2)throw new Error("fixture_anchor"); fs.writeFileSync(p,s.replace(a,a+"\n    initializer.registerRpc(\"test.filter.driver\", rpcFilterDriverFixture);")+"\n"+fs.readFileSync("/tmp/nakama-filter-fixture.js","utf8"));' && rm /tmp/nakama-filter-fixture.js

# Docker's final/default target is always operational. Omitting --target must
# never silently select the deliberately unsafe disposable test image above.
FROM nakama-filter-base AS nakama-filter
